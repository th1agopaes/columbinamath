# Modelo de configuração. Copie para .env e preencha: cp .env.example .env
# Gere a SECRET_KEY com: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-gerada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados do container (docker-compose.yml). Sem o POSTGRES_HOST, o Django
# usa o SQLite local; o compose define POSTGRES_HOST=db só para o container da aplicação.
POSTGRES_DB=columbinamath
POSTGRES_USER=columbinamath
POSTGRES_PASSWORD=troque-por-uma-senha-gerada

# Senha do usuário admin do Grafana (painel de monitoramento em http://localhost:3000)
GF_SECURITY_ADMIN_PASSWORD=troque-por-uma-senha-gerada
